# ============================================================================
# Multiple databases (demo + clients): put them in backend/databases.json
# (copy databases.example.json). Each entry carries its own service-account
# credentials and settings; anything an entry leaves out falls back to the
# values below. When databases.json exists, GEOTAB_DATABASE/ALLOWED_DATABASES
# are ignored.
#
# Single database: leave databases.json absent and fill these in.
# ============================================================================
GEOTAB_USERNAME=automations@gpsfms.com
GEOTAB_PASSWORD=change-me
GEOTAB_DATABASE=ilb
ALLOWED_DATABASES=ilb
# Optional: pin the server (e.g. my123.geotab.com). Leave blank to let the
# authenticate call discover it.
GEOTAB_SERVER=

# ---- Where the General Foreman groups live ----
# Comma-separated group NAMES or IDs. The selectable GF list is every direct
# child of each parent (set GF_INCLUDE_DESCENDANTS=true to include deeper
# levels too). Example: a "General Foremen" group per division, or one global
# "General Foremen" group.
GF_PARENT_GROUPS=General Foremen
GF_INCLUDE_DESCENDANTS=false
# Seconds to cache the GF group list (groups rarely change)
GF_CACHE_SECONDS=300

# Which user field(s) the selection is written to:
#   driver   → User.driverGroups (default; the DVIR/pre-trip report keys off this)
#   company  → User.companyGroups (data-access scope)
#   both
ASSIGN_FIELD=driver

# ---- CORS ----
# Geotab Drive injects the add-in into its own page, so the browser origin is
# the Drive/MyGeotab host. Any *.geotab.com origin is allowed by default; add
# extra exact origins (e.g. GitHub Pages for standalone testing) here.
EXTRA_CORS_ORIGINS=https://austin-gpsfms.github.io

# ---- Audit log (JSON lines) ----
AUDIT_LOG=audit.jsonl

# ---- Pre-trip emailer defaults (per-database overrides in databases.json) ----
EMAIL_ENABLED=true
REPORT_TZ=America/Los_Angeles
# Comma-separated "To" for the per-GF emails when no recipients.json entry
# and no MyGeotab user matches the GF group name.
FALLBACK_TO=safety@example.com
# Always CC'd on every GF email (comma-separated). Optional.
CC_ALL=
# Who gets the "unassigned drivers" summary (drivers who did a pre-trip but
# have not picked a GF). Defaults to FALLBACK_TO.
UNASSIGNED_TO=
# Subject prefix
SUBJECT_PREFIX=[ILB] Pre-Trip Completed

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=reports@gpsfms.com
SMTP_PASSWORD=change-me
SMTP_FROM=GPSFMS Reports <reports@gpsfms.com>
SMTP_STARTTLS=true
